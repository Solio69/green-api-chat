{
  "name": "green-api-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:query": "playwright test --config playwright.query.config.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:report": "playwright show-report",
    "test:install-browser": "playwright install chromium",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix --max-warnings=0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "iron-session": "9.0.1",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3"
  }
}
